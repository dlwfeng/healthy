# 复制为 .env 后填写。不要提交 .env。

# 必填：MiniMax API Key，用于健康助手与餐食识别
MINIMAX_CN_API_KEY=

# 可选：餐食识别模型候选，逗号分隔
MINIMAX_MEAL_MODEL=

# 本地 PostgreSQL 密码
HEALTH_DB_PASSWORD=healthy_local_dev

# 手机安装包内置的服务地址
HEALTH_API_URL=http://localhost:3060

# 可选：Zepp Life 体脂秤同步
ZEPP_APP_TOKEN=
ZEPP_USER_ID=
ZEPP_BASE_URL=https://api-mifit-cn.huami.com

# 可选：容器访问外网使用的代理
PI_HTTP_PROXY=
PI_HTTPS_PROXY=
